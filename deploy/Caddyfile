# Caddy automatically gets and renews a Let's Encrypt TLS cert for this domain —
# no manual certbot setup needed. Replace with your real domain/subdomain
# (see DEPLOY_ORACLE.md for a free DuckDNS option).
{$DOMAIN} {
	encode gzip

	# API, WebSocket, and uploaded-file requests go to the backend container.
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /ws/* {
		reverse_proxy backend:8000
	}
	handle /uploads/* {
		reverse_proxy backend:8000
	}
	handle /docs* {
		reverse_proxy backend:8000
	}
	handle /openapi.json {
		reverse_proxy backend:8000
	}

	# Everything else is the built React app (a single-page app, so unknown
	# paths like /login or /signup must still resolve to index.html).
	handle {
		root * /srv/frontend
		try_files {path} /index.html
		file_server
	}
}
