# Local dev default: SQLite + an in-process fake Redis, no external services required.
# Swap DATABASE_URL to Postgres (asyncpg) and REDIS_URL to a real redis:// URL for production.
DATABASE_URL=sqlite+aiosqlite:///./hybridchat.db
REDIS_URL=fake
JWT_SECRET=change_this_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CLIENT_URL=http://localhost:5173
UPLOAD_DIR=./uploads
